# ─────────────────────────────────────────────────
# Talakunchi Intern Management System — Backend .env
# Copy this file to .env and fill in actual values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/intern_management

# ── JWT / Session ─────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Google OAuth (Option A) ───────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
ALLOWED_EMAIL_DOMAIN=talakunchi.com

# ── Encryption Key for Sensitive Data ────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key-and-paste-here

# ── CORS ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Environment ───────────────────────────────────
ENVIRONMENT=development
